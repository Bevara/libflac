{
    "name": "libflac",
    "description": "FLAC audio decoder",
    "filters":["flacdec","rfflacm"],
    "help": "This filter decodes FLAC audio files using libFLAC.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/libflac.accessor",
    "filter_source":{
        "flacdec" : "dec_flac.c",
        "rfflacm" : "reframe_flac.c"
    },
    "extension":{
      "flac" : "audio"
    },
    "licence_required":false
}
